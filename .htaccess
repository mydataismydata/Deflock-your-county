# Deflock St. Johns
# Apache configuration for Ionos shared hosting.

Options -Indexes
DirectoryIndex index.php
ErrorDocument 404 /404.php

# Never serve version control or environment files, even if one gets uploaded.
RedirectMatch 404 /\.(git|hg|svn|env)

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS. Every test must fail before the redirect fires. Loopback is
  # exempt so a local Apache on plain http does not bounce forever, and the
  # proxy header is checked so the live site does not loop behind Ionos's
  # TLS termination.
  RewriteCond %{HTTP_HOST} !^localhost(:[0-9]+)?$ [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:[0-9]+)?$ [NC]
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # /index.php is just /
  RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # Anyone who asks for /about.php gets sent to /about.
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Serve /about from about.php without changing the address bar.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([^.]+)$ $1.php [L]
</IfModule>

# The headers for the pages are sent by includes/config.php, not from here.
# This block only runs where mod_headers exists, and a host without it skips
# the block without saying so. Ionos shared hosting is such a host, which is
# how the live site ended up with no policy at all.
#
# What stays here is the one header PHP cannot send. Apache serves the
# stylesheet, the script, the fonts and the images without PHP ever running.
# Setting the other four here as well would send every header twice on every
# page: "Header always set" writes to err_headers_out, which Apache appends to
# the response PHP already built rather than replacing it.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|png|webp|svg|ico|txt|json|xml)$">
    Header always set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 7 days"
  ExpiresByType application/javascript  "access plus 7 days"
  ExpiresByType image/svg+xml           "access plus 30 days"
  ExpiresByType image/png               "access plus 30 days"
  ExpiresByType image/webp              "access plus 30 days"
  # The font files are content-stable: a new cut gets a new name.
  ExpiresByType font/woff2              "access plus 1 year"
</IfModule>
